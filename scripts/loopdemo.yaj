// loopdemo.yaj - REPEAT / ITR / 動的添字アクセスのショーケース（v0.4.4）
//
// 配列(VAR)を「ループで埋めて → ループで走査」する典型パターン:
//   N -> REPEAT … END と ITR(1..N)   … 固定回ループと反復カウンタ
//   ITR, 値 -> VAR                    … 動的ライト（VAR[ITR-1] に書く）
//   ITR -> VAR                        … 動的リード（VAR[ITR-1] を読む・チェイン可）
// v0.4.3 の RAND / MAX も併用し、8個の擬似センサ値の各要素・合計・最大を出す。
// 後半では 4重ネストの REPEAT で、ITR が「その位置を囲む最内ループ」を指す＝
// 階層ごとに独立したカウンタになることを確認する（ネスト上限 CFG_LOOP_NEST=4）。
//
// REPEAT は「1 tick 内で完結する計算」なので中で WAIT は書けない（コンパイルエラー）。
// ペース配分の WAIT はループの外（MAIN 末尾）に置く。
//
// PCで試す: build\script.exe run scripts\loopdemo.yaj 5

MAIN
    NOW -> SEED                          // 実行ごとに乱数列を変える

    // --- 8要素の配列を乱数で埋める（動的ライト） ---
    8 -> REPEAT
        ITR, RAND % 100 -> VAR           // VAR[ITR-1] = 0..99
    END

    // --- 走査して各要素・合計・最大を求める（動的リード） ---
    0 -> GVAR[0]                          // 合計
    0 -> GVAR[1]                          // 最大
    8 -> REPEAT
        ITR -> VAR -> GVAR[2]             // v = VAR[ITR-1]
        GVAR[0] + GVAR[2] -> GVAR[0]      // 合計 += v
        GVAR[1], GVAR[2] -> MAX -> GVAR[1]// 最大 = max(最大, v)
        "  VAR[", ITR, "] = ", GVAR[2] -> STDOUT
    END

    "sum=", GVAR[0], " max=", GVAR[1] -> STDOUT

    // --- ネストした REPEAT では ITR が階層ごとに独立していることを見る（4重ループ） ---
    //
    // ITR は「その位置を囲む “最内” の REPEAT」の反復数を指す。
    // つまり各階層で ITR を読めば、その階層自身のカウンタになる（＝階層ごとに独立）。
    // 逆に言うと、内側へ入った時点で ITR は内側を指すので、最内で4階層ぶんを
    // まとめて出したいなら、外側の ITR はその場で退避しておく必要がある。
    // （ここでは配列デモを終えた VAR[0..2] を退避用スクラッチとして再利用する）
    //
    // ネスト上限は CFG_LOOP_NEST=4 段。この4重ループはちょうど上限いっぱい。
    "-- nested ITR (2x2x2x2) --" -> STDOUT
    2 -> REPEAT                               // 第1階層: ここの ITR = 1..2
        ITR -> VAR[0]                         //   第1階層の ITR を退避
        2 -> REPEAT                           // 第2階層: ここの ITR = 1..2
            ITR -> VAR[1]                     //   第2階層の ITR を退避
            2 -> REPEAT                       // 第3階層: ここの ITR = 1..2
                ITR -> VAR[2]                 //   第3階層の ITR を退避
                2 -> REPEAT                   // 第4階層（最内）: ここの ITR = 1..2
                    // この位置の ITR は第4階層のもの。外側3つは退避値で参照する
                    "  %d-%d-%d-%d", VAR[0], VAR[1], VAR[2], ITR -> FORMATTER -> STDOUT
                END
            END
        END
    END
    "----" -> STDOUT

    2000 -> WAIT                          // 次の一巡まで待つ（REPEATの外＝OK）
END
