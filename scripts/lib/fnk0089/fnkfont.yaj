// fnkfont.yaj - FNK0089向け5x7英字フォント
// ASCII, column(0..5) -> _FONT_COL_
// column 0..4が字形、column 5は文字間の空白です。
// 使用するグローバルスロット: なし

// A-Z、空白、!、? の順。各文字は縦5列＋空白1列です。
def_alias(FNK_FONT_DATA, "\
126,17,17,17,126,0,\
127,73,73,73,54,0,\
62,65,65,65,34,0,\
127,65,65,34,28,0,\
127,73,73,73,65,0,\
127,9,9,9,1,0,\
62,65,73,73,122,0,\
127,8,8,8,127,0,\
65,65,127,65,65,0,\
32,64,65,63,1,0,\
127,8,20,34,65,0,\
127,64,64,64,64,0,\
127,2,12,2,127,0,\
127,4,8,16,127,0,\
62,65,65,65,62,0,\
127,9,9,9,6,0,\
62,65,81,33,94,0,\
127,9,25,41,70,0,\
38,73,73,73,50,0,\
1,1,127,1,1,0,\
63,64,64,64,63,0,\
31,32,64,32,31,0,\
127,32,24,32,127,0,\
99,20,8,20,99,0,\
3,4,120,4,3,0,\
97,81,73,69,67,0,\
0,0,0,0,0,0,\
0,0,95,0,0,0,\
2,1,81,9,6,0")

def_port(_FONT_COL_, T_INT)

PORT _FONT_COL_
	def_local(CHAR_CODE, VAR[0])
	def_local(COLUMN, VAR[1])
	def_local(GLYPH, VAR[2])

	ARG[0] -> CHAR_CODE
	ARG[1], 0, 5 -> CLAMP -> COLUMN
	-1 -> GLYPH

	((CHAR_CODE >= 65) & (CHAR_CODE <= 90)) -> IFYES
		CHAR_CODE - 65 -> GLYPH
	END
	(CHAR_CODE == 32) -> IFYES
		26 -> GLYPH
	END
	(CHAR_CODE == 33) -> IFYES
		27 -> GLYPH
	END
	(CHAR_CODE == 63) -> IFYES
		28 -> GLYPH
	END

	(GLYPH < 0) -> IFYES
		0 -> EXIT
	END
	FNK_FONT_DATA, ",", GLYPH * 6 + COLUMN + 1 -> FIELD
	SRESULT, 10 -> STRTOL -> EXIT
END
