// USBシリアル入力をLEDでモールス送信するイベント駆動サンプルです。
// 英字を入力してEnterを押してください。Ctrl+Cでローダーへ戻ります。
// タイミングは短点=1単位、長点=3単位、符号間=1単位、文字間=3単位、単語間=7単位です。
//
// 設計上、MAINの状態機械もポーリングも使いません。各ハンドラが
// `-> HANDLER AFTER <ms>`で次の処理を予約し、送信全体を自己駆動する
// 1本のイベントチェインにします。文字位置、符号位置、点灯・消灯状態など
// ステップごとに変わる状態は引数で運び、チェインより長く生存する値だけを
// グローバルに保持します。
//
//   ON USB_SERIAL   入力行を編集し、Enterでチェインを開始
//   ON MORSE_LETTER (index)                     index番目の文字を選び、符号を開始
//   ON MORSE_SYMBOL (code, pos, on_off, index)  LEDを操作し、次の処理を予約
//
// ACTIVE_LINEをグローバルにする理由は、MORSE_SYMBOLが4つの引数位置を
// code、pos、on_off、indexで使い切るためです。入力行まで引数で運ぶとARGが
// 足りず、120msごとに文字列全体を無駄にコピーすることにもなります。
// BUSYをグローバルにする理由は、送信中の入力を無視する必要があることを
// USB_SERIALへ知らせるためだけです。

def_alias(INPUT_LINE,  SGVAR[0])
def_alias(ACTIVE_LINE, SGVAR[1])
def_alias(BUSY,        GVAR[0])

def_alias(UNIT_MS, 120)
def_alias(ALPHABET, "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
def_alias(MORSE_TABLE, ".- -... -.-. -.. . ..-. --. .... .. .--- -.- .-.. -- -. --- .--. --.- .-. ... - ..- ...- .-- -..- -.-- --..")

def_handler(MORSE_LETTER)
def_handler(MORSE_SYMBOL)

INIT
    "" -> INPUT_LINE
    "" -> ACTIVE_LINE
    0 -> BUSY
    "Type A-Z and press Enter." -> STDOUT
END

MAIN
    1000000 -> WAIT           // MAINだけを休止し、ハンドラと遅延postは動かし続けます
END

// --- 文字ループ: ACTIVE_LINEのINDEX番目を選び、その符号を開始します ---
ON MORSE_LETTER
    def_local(INDEX,  ARG[0])
    def_local(LEN,    VAR[0])
    def_local(POS,    VAR[1])
    def_local(LETTER, SVAR[0])
    def_local(CODE,   SVAR[1])

    ACTIVE_LINE -> COUNTER -> LEN
    (INDEX > LEN) -> IFYES                    // 入力行の送信完了
        "[morse] done" -> STDOUT
        "" -> ACTIVE_LINE
        0 -> BUSY                             // USB_SERIALの入力受付を再開
        EXIT
    END

    ACTIVE_LINE, INDEX, 1 -> SLICER -> LETTER
    ALPHABET, LETTER -> FINDER -> POS

    (POS > 0) -> IFYES                        // A-Zなら対応する符号を送信開始
        MORSE_TABLE, POS -> FIELD -> CODE
        CODE, 1, 1, INDEX -> MORSE_SYMBOL
        EXIT
    END

    " ", LETTER -> EQUALS -> IFYES            // 単語間隔
        // 直前の文字で3単位消灯済みなので、4単位を足して合計7単位にします。
        INDEX + 1 -> MORSE_LETTER AFTER UNIT_MS * 4
        EXIT
    END

    INDEX + 1 -> MORSE_LETTER                 // 未対応文字は待たずに読み飛ばします
END

// --- 符号ループ: ON_OFF=1で点灯、ON_OFF=0で消灯して間隔を作ります ---
ON MORSE_SYMBOL
    def_local(CODE,   SARG[0])
    def_local(POS,    ARG[1])
    def_local(ON_OFF, ARG[2])
    def_local(INDEX,  ARG[3])
    def_local(LEN,    VAR[0])
    def_local(TIME,   VAR[1])
    def_local(CH,     SVAR[0])

    CODE -> COUNTER -> LEN
    (POS > LEN) -> IFYES                      // 符号完了（文字間隔も待機済み）
        INDEX + 1 -> MORSE_LETTER
        EXIT
    END

    (ON_OFF == 1) -> IFYES                    // 短点は1単位、長点は3単位点灯
        CODE, POS, 1 -> SLICER -> CH
        CH, "." -> EQUALS -> IFYES
            UNIT_MS -> TIME
        ELSE
            UNIT_MS * 3 -> TIME
        END
        1 -> LED1
        CODE, POS, 0, INDEX -> MORSE_SYMBOL AFTER TIME
        EXIT
    END

    0 -> LED1                                 // 消灯して間隔を作ります
    (POS < LEN) -> IFYES
        UNIT_MS -> TIME                       // 符号間隔は1単位
    ELSE
        UNIT_MS * 3 -> TIME                   // 文字間隔は3単位
    END
    CODE, POS + 1, 1, INDEX -> MORSE_SYMBOL AFTER TIME
END

ON USB_SERIAL
    def_local(BYTE,         ARG[0])
    def_local(INPUT_LENGTH, VAR[0])
    def_local(INPUT_CHAR,   SVAR[0])

    (BUSY != 0) -> IFYES                      // 送信中の入力は無視します
        EXIT
    END

    // CRまたはLFで入力を確定します。CRLFの2文字目は無視します。
    ((BYTE == 13) | (BYTE == 10)) -> IFYES
        INPUT_LINE -> COUNTER -> INPUT_LENGTH
        (INPUT_LENGTH > 0) -> IFYES
            INPUT_LINE -> UPPER -> ACTIVE_LINE
            "" -> INPUT_LINE
            1 -> BUSY
            "Morse: ", ACTIVE_LINE -> STDOUT
            1 -> MORSE_LETTER                 // イベントチェインを開始します
        END
        EXIT
    END

    // Enter前ならBackspaceまたはDeleteで入力行を編集できます。
    ((BYTE == 8) | (BYTE == 127)) -> IFYES
        INPUT_LINE -> COUNTER -> INPUT_LENGTH
        (INPUT_LENGTH > 0) -> IFYES
            INPUT_LINE, 1, INPUT_LENGTH - 1 -> SLICER -> INPUT_LINE
        END
        EXIT
    END

    BYTE -> CHR -> INPUT_CHAR
    INPUT_LINE, INPUT_CHAR -> MERGER -> INPUT_LINE
END
