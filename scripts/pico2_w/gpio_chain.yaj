// Yajirのスクリプト内ポートで作る、固定GPIOピンのラッパーです。
// GPIO15へLEDと抵抗を接続するか、テスターでピンの状態を確認してください。
def_port(GPIO15, T_INT)

PORT GPIO15
    15, ARG[0] -> GPIO_SET
    15 -> GPIO_GET -> EXIT
END

INIT
    15, GPIO_OUT -> GPIO_MODE
END

MAIN
    1 -> GPIO15 -> STDOUT
    500 -> WAIT
    0 -> GPIO15 -> STDOUT
    500 -> WAIT
END
