// Yajirだけで実装したユーティリティポートです。
// アンダースコアは矢印を接続できる側を表します。
//   GPIO26_  -> value        入力
//   value -> _GPIO26         出力
//   value -> _GPIO26_ -> ... 入出力チェイン
// パッシブ圧電ブザーはGPIO15とGNDの間へ接続してください。
// _MOTORには外部モータードライバが必要です。モーターをGPIOへ直接接続しないでください。
// PWM=GPIO16、DIR=GPIO17とし、GNDを共通にします。

def_port(GPIO26_,  T_INT)
def_port(_GPIO26,  T_INT)
def_port(_GPIO26_, T_INT)
def_port(_BUZZAR,  T_INT)
def_port(_MOTOR,   T_INT)

def_alias(BUZZAR_PIN,   15)
def_alias(BUZZAR_LEVEL, 32768)
def_alias(MOTOR_PWM_PIN, 16)
def_alias(MOTOR_DIR_PIN, 17)
def_alias(MOTOR_PWM_HZ,  20000)

PORT GPIO26_
    26, GPIO_IN -> GPIO_MODE
    26 -> GPIO_GET -> EXIT
END

PORT _GPIO26
    26, GPIO_OUT -> GPIO_MODE
    26, ARG[0] -> GPIO_SET -> EXIT
END

PORT _GPIO26_
    ARG[0] -> _GPIO26
    26 -> GPIO_GET -> EXIT
END

// 符号付きモーター速度は-100から100です。0でPWMを停止します。
PORT _MOTOR
    def_local(SPEED, VAR[0])
    def_local(DUTY,  VAR[1])

    ARG[0], -100, 100 -> CLAMP -> SPEED
    SPEED -> ABS -> DUTY
    DUTY, 0, 100, 0, PWM_MAX -> MAP -> DUTY

    // 回転方向を変える前に駆動を停止します。
    MOTOR_PWM_PIN, 0 -> PWM_SET
    MOTOR_DIR_PIN, GPIO_OUT -> GPIO_MODE

    (SPEED < 0) -> IFYES
        MOTOR_DIR_PIN, 0 -> GPIO_SET
    ELSE
        MOTOR_DIR_PIN, 1 -> GPIO_SET
    END

    MOTOR_PWM_PIN, MOTOR_PWM_HZ -> PWM_FREQ
    MOTOR_PWM_PIN, DUTY -> PWM_SET
    SPEED -> EXIT
END

PORT _BUZZAR
    def_local(NOTE,      ARG[0])
    def_local(FREQUENCY, VAR[0])

    NOTE -> FREQUENCY

    (NOTE == 'C') -> IFYES
        262 -> FREQUENCY
    END
    (NOTE == 'D') -> IFYES
        294 -> FREQUENCY
    END
    (NOTE == 'E') -> IFYES
        330 -> FREQUENCY
    END
    (NOTE == 'F') -> IFYES
        349 -> FREQUENCY
    END
    (NOTE == 'G') -> IFYES
        392 -> FREQUENCY
    END
    (NOTE == 'A') -> IFYES
        440 -> FREQUENCY
    END
    (NOTE == 'B') -> IFYES
        494 -> FREQUENCY
    END
    (NOTE == 'R') -> IFYES
        0 -> FREQUENCY
    END

    (FREQUENCY <= 0) -> IFYES
        BUZZAR_PIN, 0 -> PWM_SET
        0 -> EXIT
    ELSE
        BUZZAR_PIN, FREQUENCY -> PWM_FREQ
        BUZZAR_PIN, BUZZAR_LEVEL -> PWM_SET
        FREQUENCY -> EXIT
    END
END

INIT
    "GPIO26 input: ", GPIO26_ -> STDOUT

    1 -> _GPIO26_ -> STDOUT
    0 -> _GPIO26

    'C' -> _BUZZAR
    250 -> WAIT
    'E' -> _BUZZAR
    250 -> WAIT
    'G' -> _BUZZAR
    250 -> WAIT
    'A' -> _BUZZAR
    500 -> WAIT
    0 -> _BUZZAR

    // モーターの例は安全のため自動実行しません。
    //  50 -> _MOTOR   // 50パーセントで正転
    // -30 -> _MOTOR   // 30パーセントで逆転
    //   0 -> _MOTOR   // 停止
END
