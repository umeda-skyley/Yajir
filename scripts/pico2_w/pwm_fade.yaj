// PWM fade on GPIO15. Connect an LED in series with a resistor.
// Ctrl+C stops PWM and returns the pin to Low.

def_alias(PWM_PIN, 15)
def_alias(PWM_STEP, 4096)
def_alias(PWM_PEAK, 61440)
def_alias(LEVEL, GVAR[0])
def_alias(DIRECTION, GVAR[1])

INIT
    PWM_PIN, 1000 -> PWM_FREQ
    0 -> LEVEL
    1 -> DIRECTION
END

MAIN
    LEVEL + DIRECTION * PWM_STEP -> LEVEL

    (LEVEL >= PWM_PEAK) -> IFYES
        -1 -> DIRECTION
    END

    (LEVEL <= 0) -> IFYES
        1 -> DIRECTION
    END

    PWM_PIN, LEVEL -> PWM_SET
    40 -> WAIT
END
