// fib.yaj - フィボナッチ数列
//
// Yajir には while / for は無いが、ループ構文は要らない:
//   - FIBハンドラの自己呼び出しで実現
//
// 計算は int32 なので F(46)=1,836,311,903 の次で桁あふれする。
// そこで >1e9 になったら 0,1 に戻して延々ループさせている。

def_handler(FIB)

INIT
    0 -> GVAR[0]      // a = F(n)
    1 -> GVAR[1]      // b = F(n+1)
END

MAIN
	100 -> FIB
    1000000 -> WAIT
END

ON FIB
	(ARG[0] == 0 ) -> IFYES
		"--- finished ---" -> STDOUT
		EXIT
	END
	
    (GVAR[0] > 1000000000) -> IFYES   // 桁あふれ直前でリセット
        "--- restart ---" -> STDOUT
        0 -> GVAR[0]
        1 -> GVAR[1]
    END
    
	"fib: ", GVAR[0] -> STDOUT        // 現在項を出力
    GVAR[0] + GVAR[1] -> GVAR[2]      // c = a + b （GVAR[2]=一時変数）
    GVAR[1] -> GVAR[0]                // a = b
    GVAR[2] -> GVAR[1]                // b = c
    
	(ARG[0] - 1) -> FIB
END