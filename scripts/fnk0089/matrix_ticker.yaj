// 5x7フォントで任意の英文を右から左へ流します。
// fnkmat.yajとfnkfont.yajをYAJIRドライブへ置いてください。

def_import("fnkmat")
def_import("fnkfont")

def_alias(TICKER_TEXT, "HELLO WORLD!?")
def_alias(GLYPH_COLUMNS, 6)
def_alias(DISPLAY_COLUMNS, 16)
def_alias(FRAME_MS, 80)

def_alias(SCROLL_POS, GVAR[0])
def_alias(TEXT_LENGTH, GVAR[1])

INIT
	0 -> _MATRIX_INIT
	8 -> _MATRIX_BRIGHT
	TICKER_TEXT -> COUNTER -> TEXT_LENGTH
	0 -> SCROLL_POS
	"[FNK0089] ", TICKER_TEXT -> STDOUT
END

MAIN
	def_local(STREAM_COL, VAR[0])
	def_local(TEXT_COL, VAR[1])
	def_local(CHAR_CODE, VAR[2])
	def_local(PATTERN, VAR[3])

	DISPLAY_COLUMNS -> REPEAT
		SCROLL_POS + ITR - 1 -> STREAM_COL
		0 -> PATTERN

		((STREAM_COL >= DISPLAY_COLUMNS) & \
		 (STREAM_COL < DISPLAY_COLUMNS + TEXT_LENGTH * GLYPH_COLUMNS)) -> IFYES
			STREAM_COL - DISPLAY_COLUMNS -> TEXT_COL
			TICKER_TEXT, TEXT_COL / GLYPH_COLUMNS + 1, 1 -> SLICER
			SRESULT -> ASC -> CHAR_CODE
			CHAR_CODE, TEXT_COL % GLYPH_COLUMNS -> _FONT_COL_ -> PATTERN
		END

		ITR - 1, PATTERN -> _MATRIX_COL_
	END
	0 -> _MATRIX_SHOW

	SCROLL_POS + 1 -> SCROLL_POS
	(SCROLL_POS > DISPLAY_COLUMNS + TEXT_LENGTH * GLYPH_COLUMNS) -> IFYES
		0 -> SCROLL_POS
	END
	FRAME_MS -> WAIT
END
