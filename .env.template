[OPEN_AI]
# ここにAPI Keyを張って
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
PORT=5173

[ANTHOROPIC]
# ここにAPI Keyを張って
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

[GOOGLE}
# ここにAPI Keyを張って
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# AI port configuration defaults
# These values are sent explicitly by GPT / CLAUDE / GEMINI ports.

# OpenAI GPT port settings
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_TEMPERATURE=1
OPENAI_TOP_P=
OPENAI_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=medium
OPENAI_INSTRUCTIONS=You are a helpful assistant.

# Anthropic Claude port settings
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=1
CLAUDE_TOP_P=
CLAUDE_TOP_K=
CLAUDE_SYSTEM=You are a helpful assistant.
CLAUDE_THINKING_TYPE=disabled
CLAUDE_THINKING_BUDGET_TOKENS=1024
CLAUDE_THINKING_DISPLAY=summarized

# Google Gemini port settings
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=1
GEMINI_TOP_P=
GEMINI_TOP_K=
GEMINI_THINKING_LEVEL=medium
GEMINI_SYSTEM_INSTRUCTION=You are a helpful assistant.
